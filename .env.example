APP_NAME=ThesisCap
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack

# XAMPP / MySQL (create an empty database named "thesiscap" in phpMyAdmin first)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=thesiscap
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
FILESYSTEM_DISK=local

# Shows the "Demo accounts" dropdown on the login page. Set to false in production.
SHOW_DEMO_ACCOUNTS=true
